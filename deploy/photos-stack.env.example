# photos-stack configuration.
#
#   cp deploy/photos-stack.env.example deploy/photos-stack.env
#   $EDITOR deploy/photos-stack.env
#   ./deploy/photos-stack.sh preflight
#
# photos-stack.env is gitignored: it names real buckets and AWS profiles, which
# differ per environment and per developer. Keep this example in sync when you
# add a setting.

# ---------------------------------------------------------------- required

# Name prefix for every resource this creates. With PROJECT=myapp you get the
# functions myapp-photos and myapp-photos-cleanup, and the roles
# myapp-photos-role and myapp-photos-cleanup-role.
PROJECT=myapp

# Where your application uploads originals.
SOURCE_BUCKET=myapp-uploads

# Where derivatives are written. This MUST be a different bucket: the optimizer
# runs on ObjectCreated, so writing derivatives back into the bucket that
# triggers it recurses forever. preflight refuses to continue if they match.
DEST_BUCKET=myapp-media

# ---------------------------------------------------------------- aws

REGION=us-east-1

# Named AWS CLI profile. Leave empty to use the default credential chain,
# which is usually what you want in CI.
PROFILE=

# ---------------------------------------------------------------- sizing

# arm64 is roughly 20% cheaper per GB-second and this code has no x86-specific
# assembly, so there is little reason to use x86_64.
ARCH=arm64

# 1769 MB is the point where Lambda allocates a full vCPU. Below it the work is
# CPU-throttled and stretches proportionally, so GB-second cost stays roughly
# flat while latency gets worse.
MEMORY=1769
TIMEOUT=60

CLEANUP_MEMORY=512
CLEANUP_TIMEOUT=30

# ---------------------------------------------------------------- images
#
# Leave these unset to get the built-in defaults, which are the six CSS
# breakpoints No Nonsense Recipes uses. Any other project should set its own.

# Maximum box per output, as name:width,height pairs separated by semicolons.
# The NAMES become the output filenames, so name them for how your markup will
# select them. Images are never upscaled and aspect ratio is always preserved,
# so these are bounds, not exact dimensions.
#DIMENSIONS="hero:1600,1200;card:800,600;tile:400,300"

# Output formats. jpeg, webp and png are supported.
#FORMATS="jpeg,webp"

# Thumbnail edge in px. The thumbnail is a centre-cropped square, encoded at
# quality 95 while every other derivative uses 75.
#THUMB_SIZE=128

# ---------------------------------------------------------------- verify

# Key prefix used by `verify` for its throwaway test image. It must sit inside
# whatever key scope your execution roles permit: a cleanup role restricted to
# "media/images/*" will deny deletes anywhere else, and verify will fail on the
# cleanup step even though the deployment is healthy. Roles created by
# `bootstrap` cover the whole destination bucket, so the default is fine for
# new projects.
#VERIFY_PREFIX=_photos-stack-verify

# ---------------------------------------------------------------- overrides
#
# Function and role names are derived from PROJECT. Override them only when
# adopting a deployment that predates this script and uses other names.
#FN_PHOTOS=myapp-photos
#FN_CLEANUP=myapp-photos-cleanup
#ROLE_PHOTOS=myapp-photos-role
#ROLE_CLEANUP=myapp-photos-cleanup-role
